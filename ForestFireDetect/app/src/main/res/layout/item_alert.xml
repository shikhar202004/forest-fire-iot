<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#1A0A0A"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvAlertLabel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/red" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvAlertScore"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/red" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:id="@+id/tvAlertSensor"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="12sp" android:layout_marginTop="4dp"/>

        <TextView android:id="@+id/tvAlertMeta"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>

        <TextView android:id="@+id/tvAlertTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="10sp" android:layout_marginTop="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>