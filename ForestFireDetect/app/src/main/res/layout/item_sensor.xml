<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/card2"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/tvSensorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/green2"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/badge_bg"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@color/bg" android:padding="8dp" android:layout_margin="3dp">
                <TextView android:text="🌡️" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvTemp" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/green2"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:text="TEMP" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="9sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@color/bg" android:padding="8dp" android:layout_margin="3dp">
                <TextView android:text="💧" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvHumidity" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/green2"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:text="HUMIDITY" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="9sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@color/bg" android:padding="8dp" android:layout_margin="3dp">
                <TextView android:text="🔥" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvSmoke" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/green2"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:text="SMOKE" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="9sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@color/bg" android:padding="8dp" android:layout_margin="3dp">
                <TextView android:text="🌬️" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvCo2" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/green2"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:text="CO₂" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="9sp"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RISK" android:textColor="@color/muted" android:textSize="9sp"
                android:layout_marginEnd="8dp"/>
            <ProgressBar android:id="@+id/progressRisk"
                android:layout_width="0dp" android:layout_height="6dp"
                android:layout_weight="1" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:max="100" android:progress="0"/>
            <TextView android:id="@+id/tvRiskScore"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/green" android:textSize="11sp" android:textStyle="bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView android:id="@+id/tvGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>